// e2e: {"mode":"run"}
struct Pair { int32 x int32 y }
fnc main() -> int32 {
    if !(sizeof int8 == 1u64) { return 1i32 }
    if !(sizeof uint8 == 1u64) { return 2i32 }
    if !(sizeof char == 1u64) { return 3i32 }
    if !(sizeof bool == 1u64) { return 4i32 }
    if !(sizeof int16 == 2u64) { return 5i32 }
    if !(sizeof uint16 == 2u64) { return 6i32 }
    if !(sizeof int32 == 4u64) { return 7i32 }
    if !(sizeof uint32 == 4u64) { return 8i32 }
    if !(sizeof float == 4u64) { return 9i32 }
    if !(sizeof int == 8u64) { return 10i32 }
    if !(sizeof uint == 8u64) { return 11i32 }
    if !(sizeof Pair == 8u64) { return 12i32 }
    if !(sizeof none* == sizeof int32*) { return 13i32 }
    if !(sizeof int32** == sizeof int32*) { return 14i32 }
    return 0i32
}
