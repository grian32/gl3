// e2e: {"mode":"run"}
fnc to_int8(int8 value) -> int8 { return value as int8 }
fnc to_int16(int8 value) -> int16 { return value as int16 }
fnc to_int32(int8 value) -> int32 { return value as int32 }
fnc to_int(int8 value) -> int { return value as int }
fnc to_uint8(int8 value) -> uint8 { return value as uint8 }
fnc to_uint16(int8 value) -> uint16 { return value as uint16 }
