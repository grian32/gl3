// e2e: {"mode":"run"}
fnc to_int8(uint16 value) -> int8 { return value as int8 }
fnc to_int16(uint16 value) -> int16 { return value as int16 }
fnc to_int32(uint16 value) -> int32 { return value as int32 }
fnc to_int(uint16 value) -> int { return value as int }
fnc to_uint8(uint16 value) -> uint8 { return value as uint8 }
fnc to_uint16(uint16 value) -> uint16 { return value as uint16 }
fnc to_uint32(uint16 value) -> uint32 { return value as uint32 }
fnc to_uint(uint16 value) -> uint { return value as uint }
fnc main() -> int32 {
    if !(to_int8(65535u16) == -1i8) { return 1i32 }
    if !(to_int16(65535u16) == -1i16) { return 2i32 }
    if !(to_int32(65535u16) == 65535i32) { return 3i32 }
    if !(to_int(65535u16) == 65535) { return 4i32 }
    if !(to_uint8(65535u16) == 255u8) { return 5i32 }
    if !(to_uint16(65535u16) == 65535u16) { return 6i32 }
    if !(to_uint32(65535u16) == 65535u32) { return 7i32 }
    if !(to_uint(65535u16) == 65535u64) { return 8i32 }
    return 0i32
}
