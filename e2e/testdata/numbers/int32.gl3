// e2e: {"mode":"run"}
fnc arithmetic(int32 a, int32 b) -> int32 { return (a + b) * b - a / b }
fnc less(int32 a, int32 b) -> bool { return a < b }
fnc le(int32 a, int32 b) -> bool { return a <= b }
fnc greater(int32 a, int32 b) -> bool { return a > b }
fnc ge(int32 a, int32 b) -> bool { return a >= b }
fnc equal(int32 a, int32 b) -> bool { return a == b }
fnc unequal(int32 a, int32 b) -> bool { return a != b }
fnc negate(int32 x) -> int32 { return -x }
fnc divide(int32 x, int32 y) -> int32 { return x / y }
fnc main() -> int32 {
    if !(arithmetic(12i32, 3i32) == 41i32) { return 1i32 }
    if !(less(2i32, 3i32)) { return 2i32 }
    if !(!less(3i32, 2i32)) { return 3i32 }
    if !(le(2i32, 2i32)) { return 4i32 }
    if !(!le(3i32, 2i32)) { return 5i32 }
    if !(greater(3i32, 2i32)) { return 6i32 }
    if !(!greater(2i32, 3i32)) { return 7i32 }
    if !(ge(2i32, 2i32)) { return 8i32 }
    if !(!ge(2i32, 3i32)) { return 9i32 }
    if !(equal(2i32, 2i32)) { return 10i32 }
    if !(!equal(2i32, 3i32)) { return 11i32 }
    if !(unequal(2i32, 3i32)) { return 12i32 }
    if !(!unequal(2i32, 2i32)) { return 13i32 }
    if !(negate(7i32) == -7i32) { return 14i32 }
    if !(divide(-7i32, 2i32) == -3i32) { return 15i32 }
    if !(less(-1i32, 1i32)) { return 16i32 }
    return 0i32
}
