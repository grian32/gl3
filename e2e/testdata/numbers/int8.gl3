// e2e: {"mode":"run"}
fnc arithmetic(int8 a, int8 b) -> int8 { return (a + b) * b - a / b }
fnc less(int8 a, int8 b) -> bool { return a < b }
fnc le(int8 a, int8 b) -> bool { return a <= b }
fnc greater(int8 a, int8 b) -> bool { return a > b }
fnc ge(int8 a, int8 b) -> bool { return a >= b }
fnc equal(int8 a, int8 b) -> bool { return a == b }
fnc unequal(int8 a, int8 b) -> bool { return a != b }
fnc negate(int8 x) -> int8 { return -x }
fnc divide(int8 x, int8 y) -> int8 { return x / y }
fnc main() -> int32 {
    if !(arithmetic(12i8, 3i8) == 41i8) { return 1i32 }
    if !(less(2i8, 3i8)) { return 2i32 }
    if !(!less(3i8, 2i8)) { return 3i32 }
    if !(le(2i8, 2i8)) { return 4i32 }
    if !(!le(3i8, 2i8)) { return 5i32 }
    if !(greater(3i8, 2i8)) { return 6i32 }
    if !(!greater(2i8, 3i8)) { return 7i32 }
    if !(ge(2i8, 2i8)) { return 8i32 }
    if !(!ge(2i8, 3i8)) { return 9i32 }
    if !(equal(2i8, 2i8)) { return 10i32 }
    if !(!equal(2i8, 3i8)) { return 11i32 }
    if !(unequal(2i8, 3i8)) { return 12i32 }
    if !(!unequal(2i8, 2i8)) { return 13i32 }
    if !(negate(7i8) == -7i8) { return 14i32 }
    if !(divide(-7i8, 2i8) == -3i8) { return 15i32 }
    if !(less(-1i8, 1i8)) { return 16i32 }
    return 0i32
}
