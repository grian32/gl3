// e2e: {"mode":"run"}
fnc arithmetic(uint8 a, uint8 b) -> uint8 { return (a + b) * b - a / b }
fnc less(uint8 a, uint8 b) -> bool { return a < b }
fnc le(uint8 a, uint8 b) -> bool { return a <= b }
fnc greater(uint8 a, uint8 b) -> bool { return a > b }
fnc ge(uint8 a, uint8 b) -> bool { return a >= b }
fnc equal(uint8 a, uint8 b) -> bool { return a == b }
fnc unequal(uint8 a, uint8 b) -> bool { return a != b }
fnc divide(uint8 a, uint8 b) -> uint8 { return a / b }
fnc main() -> int32 {
    if !(arithmetic(12u8, 3u8) == 41u8) { return 1i32 }
    if !(less(2u8, 3u8)) { return 2i32 }
    if !(!less(3u8, 2u8)) { return 3i32 }
    if !(le(2u8, 2u8)) { return 4i32 }
    if !(!le(3u8, 2u8)) { return 5i32 }
    if !(greater(3u8, 2u8)) { return 6i32 }
    if !(!greater(2u8, 3u8)) { return 7i32 }
    if !(ge(2u8, 2u8)) { return 8i32 }
    if !(!ge(2u8, 3u8)) { return 9i32 }
    if !(equal(2u8, 2u8)) { return 10i32 }
    if !(!equal(2u8, 3u8)) { return 11i32 }
    if !(unequal(2u8, 3u8)) { return 12i32 }
    if !(!unequal(2u8, 2u8)) { return 13i32 }
    if !(greater(255u8, 1u8)) { return 14i32 }
    if !(arithmetic(12u8, 3u8) == 41u8) { return 15i32 }
    if divide(255u8, 2u8) != 127u8 { return 16i32 }
    return 0i32
}
