// e2e: {"mode":"run"}
fnc arithmetic(int a, int b) -> int { return (a + b) * b - a / b }
fnc less(int a, int b) -> bool { return a < b }
fnc le(int a, int b) -> bool { return a <= b }
fnc greater(int a, int b) -> bool { return a > b }
fnc ge(int a, int b) -> bool { return a >= b }
fnc equal(int a, int b) -> bool { return a == b }
fnc unequal(int a, int b) -> bool { return a != b }
fnc negate(int x) -> int { return -x }
fnc divide(int x, int y) -> int { return x / y }
fnc main() -> int32 {
    if !(arithmetic(12, 3) == 41) { return 1i32 }
    if !(less(2, 3)) { return 2i32 }
    if !(!less(3, 2)) { return 3i32 }
    if !(le(2, 2)) { return 4i32 }
    if !(!le(3, 2)) { return 5i32 }
    if !(greater(3, 2)) { return 6i32 }
    if !(!greater(2, 3)) { return 7i32 }
    if !(ge(2, 2)) { return 8i32 }
    if !(!ge(2, 3)) { return 9i32 }
    if !(equal(2, 2)) { return 10i32 }
    if !(!equal(2, 3)) { return 11i32 }
    if !(unequal(2, 3)) { return 12i32 }
    if !(!unequal(2, 2)) { return 13i32 }
    if !(negate(7) == -7) { return 14i32 }
    if !(divide(-7, 2) == -3) { return 15i32 }
    if !(less(-1, 1)) { return 16i32 }
    return 0i32
}
