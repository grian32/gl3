// e2e: {"mode":"run","stdout":"hello world\nhello\n"}
import "strings"
extern fnc puts(char* text) -> int32
fnc main() -> int32 {
    def char* copy = dynstr("hello")
    def char* joined = str_append(copy, " world")
    if str_len(joined) != 11u64 { return 1i32 }
    if str_len("") != 0u64 { return 2i32 }
    puts(joined)
    puts(copy)
    str_free(copy)
    str_free(joined)
    return 0i32
}
