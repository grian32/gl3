// e2e: {"mode":"run","exit":6}
fnc main() -> int32 {
    def int32 outer = 0i32
    def int32 count = 0i32
    while outer < 3i32 {
        outer = outer + 1i32
        def int32 inner = 0i32
        while true {
            inner = inner + 1i32
            if inner == 2i32 { continue }
            if inner == 4i32 { break }
            count = count + 1i32
        }
    }
    return count
}
