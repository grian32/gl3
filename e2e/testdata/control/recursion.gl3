// e2e: {"mode":"run"}
fnc fib(int32 n) -> int32 {
    if n <= 1i32 { return n }
    return fib(n - 1i32) + fib(n - 2i32)
}
fnc even(int32 n) -> bool { if n == 0i32 { return true } return odd(n - 1i32) }
fnc odd(int32 n) -> bool { if n == 0i32 { return false } return even(n - 1i32) }
fnc main() -> int32 {
    if !even(10i32) { return 1i32 }
    if !odd(9i32) { return 2i32 }
    if fib(10i32) != 55i32 { return 3i32 }
    return 0i32
}
