// e2e: {"mode":"run"}
fnc choose(bool first, bool second) -> int32 {
    if first { if second { return 11i32 } else { return 12i32 } }
    else { if second { return 21i32 } else { return 22i32 } }
}
fnc main() -> int32 {
    if choose(true, true) != 11i32 { return 1i32 }
    if choose(true, false) != 12i32 { return 2i32 }
    if choose(false, true) != 21i32 { return 3i32 }
    if choose(false, false) != 22i32 { return 4i32 }
    return 0i32
}
