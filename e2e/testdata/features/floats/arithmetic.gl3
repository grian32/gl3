// e2e: {"mode":"run","stdout":"3.75\n-0.75\n3.75\n3.5\n-2.5\n"}
extern fnc malloc(uint size) -> char*
extern fnc strfromf(char* buf, uint size, char* format, float value) -> int32
extern fnc puts(char* text) -> int32
fnc show(float value) -> none {
    def char* buf = malloc(32u64)
    strfromf(buf, 32u64, "%g", value)
    puts(buf)
}
fnc half(float value) -> float { return value / 2.0 }
fnc main() -> int32 {
    show(1.5 + 2.25)
    show(1.5 - 2.25)
    show(1.5 * 2.5)
    show(half(7.0))
    def float value = 2.5
    show(-value)
    return 0i32
}
