// e2e: {"mode":"run","stdout":"3.75\n-0.75\n3.75\n3.5\n-2.5\n"}
// strfromf is glibc-only, so print floats by hand: sign, whole part, then up to two decimals.
extern fnc putchar(int32 c) -> int32
fnc show_digits(int32 value) -> none {
    if value >= 10i32 { show_digits(value / 10i32) }
    putchar(48i32 + value % 10i32)
}
fnc show(float value) -> none {
    if value < 0.0 {
        putchar(45i32)
        value = -value
    }
    def int32 scaled = (value * 100.0 + 0.5) as int32
    show_digits(scaled / 100i32)
    def int32 frac = scaled % 100i32
    if frac != 0i32 {
        putchar(46i32)
        putchar(48i32 + frac / 10i32)
        if frac % 10i32 != 0i32 { putchar(48i32 + frac % 10i32) }
    }
    putchar(10i32)
}
fnc half(float value) -> float { return value / 2.0 }
fnc main() -> int32 {
    show(1.5 + 2.25)
    show(1.5 - 2.25)
    show(1.5 * 2.5)
    show(half(7.0))
    def float value = 2.5
    show(-value)
    return 0i32
}
