// e2e: {"mode":"run"}
struct Pair { int32 x int32 y }
global int32 counter = 1i32
global const float ratio = 1.5
global Pair pair = Pair:{7i32, 9i32}
fnc set() -> none { counter = 42i32 }
fnc main() -> int32 {
    if counter != 1i32 { return 1i32 }
    set()
    if counter != 42i32 { return 2i32 }
    if ratio != 1.5 { return 3i32 }
    if pair.x != 7i32 { return 4i32 }
    pair.y = 42i32
    if pair.y != 42i32 { return 5i32 }
    return 0i32
}
