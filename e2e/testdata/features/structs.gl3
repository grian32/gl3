// e2e: {"mode":"run"}
struct Inner { int32 a int32 b }
struct Outer { bool flag Inner inner }
fnc make(int32 b) -> Outer { return Outer:{true, Inner:{1i32, b}} }
fnc clobber(Outer value) -> none { value.inner.b = 0i32 }
fnc main() -> int32 {
    def Outer outer = make(7i32)
    if outer.flag { } else { return 1i32 }
    if outer.inner.b != 7i32 { return 2i32 }
    outer.inner.a = 5i32
    if outer.inner.b != 7i32 { return 3i32 }
    def Outer copy = outer
    copy.inner.b = 9i32
    clobber(outer)
    if outer.inner.b != 7i32 { return 4i32 }
    if make(3i32).inner.b != 3i32 { return 5i32 }
    outer = copy
    if outer.inner.b != 9i32 { return 6i32 }
    return 0i32
}
