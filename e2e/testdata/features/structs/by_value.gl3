// e2e: {"mode":"run","exit":7}
struct Inner { int32 a int32 b }
struct Outer { bool flag Inner inner }
fnc make(int32 b) -> Outer { return Outer:{true, Inner:{1i32, b}} }
fnc clobber(Outer value) -> none { value.inner.b = 0i32 }
fnc main() -> int32 {
    def Outer outer = make(7i32)
    clobber(outer)
    return outer.inner.b
}
