// e2e: {"mode":"run"}
fnc half(float value) -> float { return value / 2.0 }
fnc main() -> int32 {
    if 1.5 + 2.25 != 3.75 { return 1i32 }
    if 1.5 - 2.25 != -0.75 { return 2i32 }
    if 1.5 * 2.5 != 3.75 { return 3i32 }
    if half(7.0) != 3.5 { return 4i32 }
    if 1.5 < -1.5 { return 5i32 }
    if 2.5 >= 3.5 { return 6i32 }
    if 1.5 == 2.5 { return 7i32 }
    def float value = 2.5
    if -value != -2.5 { return 8i32 }
    return 0i32
}
