// e2e: {"mode":"run"}
fnc conjunction(bool a, bool b) -> bool { return a && b }
fnc disjunction(bool a, bool b) -> bool { return a || b }
fnc negate(bool a) -> bool { return !a }
fnc main() -> int32 {
    if !(conjunction(false, false) == false) { return 1i32 }
    if !(conjunction(false, true) == false) { return 2i32 }
    if !(conjunction(true, false) == false) { return 3i32 }
    if !(conjunction(true, true) == true) { return 4i32 }
    if !(disjunction(false, false) == false) { return 5i32 }
    if !(disjunction(false, true) == true) { return 6i32 }
    if !(disjunction(true, false) == true) { return 7i32 }
    if !(disjunction(true, true) == true) { return 8i32 }
    if !(negate(false)) { return 9i32 }
    if !(!negate(true)) { return 10i32 }
    if !(true != false) { return 11i32 }
    if !(!(true != true)) { return 12i32 }
    if !(false == false) { return 13i32 }
    return 0i32
}
